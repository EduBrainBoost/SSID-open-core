# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Text files
*.txt text eol=lf

# Certificates and keys - binary
*.crt binary
*.pem binary
*.key binary
*.p12 binary
*.pfx binary

# Binary files
*.so binary
*.dll binary
*.exe binary
*.pyc binary